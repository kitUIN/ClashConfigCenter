CCC_HOST=127.0.0.1
CCC_PORT=8000
# Relative paths resolve from backend/, not the invoking shell's directory.
CCC_DATA_DIR=data
# JSON array. Empty disables cross-origin browser access.
CCC_CORS_ORIGINS=[]
# Optional fixed external origin, used when generating subscription links.
# CCC_PUBLIC_BASE_URL=http://127.0.0.1:8000
CCC_FETCH_TIMEOUT_SECONDS=30
CCC_FETCH_MAX_BYTES=10485760
CCC_SCHEDULER_INTERVAL_SECONDS=60
